# Скопируйте в .env и заполните
BOT_TOKEN=123456:ABC-your-bot-token-from-botfather
# Имя бота без @ (для реферальных ссылок). Можно не задавать — подтянется из BOT_TOKEN через getMe.
# TELEGRAM_BOT_USERNAME=PropDeskBot
# Поддержка в Mini App (@username или бот; по умолчанию — тот же, что TELEGRAM_BOT_USERNAME / getMe)
# TELEGRAM_SUPPORT_USERNAME=PropDeskSupport
# ID группы поддержки (бот — админ; ответы админов — reply на сообщение бота). Узнать: @getidsbot или getUpdates
# TELEGRAM_SUPPORT_GROUP_ID=-1001234567890
# Через запятую: ваши Telegram user id (узнать у @userinfobot)
TELEGRAM_ADMIN_IDS=123456789
# Дополнительно в блоке «Уволенные» (помимо админов с 2 минусовыми неделями подряд)
# TELEGRAM_FORMER_ADMIN_IDS=111111111,222222222
DATABASE_URL=sqlite:///./signals.db
# На Amvera с постоянным диском (см. Dockerfile): sqlite:////data/signals.db
# Для локальной разработки фронта
CORS_ORIGINS=http://localhost:5173
# Интервал проверки цен для WIN/LOSE (секунды)
PRICE_CHECK_INTERVAL_SECONDS=60
PRICE_HTTP_TIMEOUT_SECONDS=10
DEFAULT_SIGNAL_POINTS_PERCENT=1.0
MAX_SIGNAL_POINTS_PERCENT=10.0
MEDIA_ROOT=/data/media

# Шифрование API-ключей пользователей (опционально; иначе BOT_TOKEN)
# EXCHANGE_SECRETS_KEY=

# Копирование сигналов volnovoi: пользователи сохраняют свои ключи в приложении (вкладка ТОП)
